{
  "name": "cycle-nav",
  "version": "1.0.0",
  "private": true,
  "description": "Calm bicycle navigation on OpenStreetMap",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "sync": "npm run build && npx cap sync android",
    "apk": "npm run sync && cd android && gradlew.bat assembleDebug",
    "serve": "vite preview --port 8137",
    "publish": "sh scripts/publish-web.sh"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "@maplibre/maplibre-gl-leaflet": "^0.1.4",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^5.24.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "svelte": "^5.57.2",
    "vite": "^8.3.5"
  },
  "type": "module"
}
