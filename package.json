{
  "name": "cycle-nav",
  "version": "1.0.0",
  "private": true,
  "description": "Calm bicycle navigation on OpenStreetMap",
  "scripts": {
    "build": "node scripts/copy-web.mjs",
    "sync": "npm run build && npx cap sync android",
    "apk": "npm run sync && cd android && gradlew.bat assembleDebug",
    "serve": "python scripts/serve.py 8137"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "@maplibre/maplibre-gl-leaflet": "^0.1.4",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^5.24.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3"
  }
}
